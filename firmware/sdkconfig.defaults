# Hardware build: ESP32-DevKitC (WROVER, 16 MB flash, 8 MB PSRAM), BLE mesh enabled

# Flash and partition table
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: the classic ESP32 maps 4 MB into the address space; the rest is
# reachable only through the himem API.
CONFIG_SPIRAM=y

# Task watchdog (spec 09): every AO thread is subscribed by the node_ao port
# and fed at least once a second. A thread that misses 10 s panics and resets
# the node, so the next boot logs reset_reason=task_wdt.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Bluetooth: BLE only, Bluedroid host
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# BLE mesh node
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_NODE_MESH_ENABLE=y
